{
  "name": "castle-defense",
  "version": "0.46.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit",
    "bots": "tsx server/scripts/bots.ts",
    "dev:memory": "tsx server/scripts/devMemory.ts",
    "lab": "tsx server/scripts/lab/lab.ts",
    "balance": "tsx server/scripts/lab/balance.ts",
    "balance:check": "tsx server/scripts/lab/balance.ts --check"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "tsx": "4.20.3",
    "@types/node": "22.15.30"
  }
}
