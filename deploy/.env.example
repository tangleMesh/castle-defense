# Copy to deploy/.env and fill in. (.env is never committed.)

# ---- server -------------------------------------------------------------------------------
# Release the live server runs. update.sh sets this automatically when a new GitHub release
# appears; set it by hand to pin or roll back (e.g. CASTLE_VERSION=v0.57.0).
CASTLE_VERSION=latest
CASTLE_IMAGE=ghcr.io/tanglemesh/castle-defense
# Local port the Cloudflare tunnel points at (http://localhost:8080). Bound to 127.0.0.1 only.
HOST_PORT=8080
# Same name as the dev setup, so a dump from there restores 1:1
DB_NAME=bastion_clash
# Background bot learner: always | idle | off
LEARNER=always
LEARNER_GAMES_PER_HOUR=0
# Secret for /api/learner/rollback and /api/learner/models (any long random string)
ADMIN_TOKEN=

# ---- automatic updates (update.sh) --------------------------------------------------------
# 1 = install new GitHub releases automatically; 0 = stay on CASTLE_VERSION (pin / rollback)
AUTO_UPDATE=1
GITHUB_REPO=tangleMesh/castle-defense
# Only needed if the repository or its package is private (a token with read:packages / repo)
GITHUB_TOKEN=
# Wait at most this many minutes for running matches to end before updating anyway
UPDATE_MAX_WAIT_MIN=120

# ---- backups to AWS S3 --------------------------------------------------------------------
S3_BUCKET=
S3_PREFIX=castle-defense
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
# Every N hours (168 = weekly)
BACKUP_INTERVAL_HOURS=168
# Keep the newest N backups in S3 (0 = keep all)
BACKUP_KEEP=12
